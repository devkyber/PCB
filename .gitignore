# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
# Agent implementation evidence is local, not product source.
.superpowers/
# Transactional local drafts, reports, and state
.pcb-copilot/

# OS
.DS_Store
Thumbs.db

# KiCad
*.kicad_pcb-bak
*.kicad_sch-bak
fp-info-cache
*~

# Editors
.vscode/
.idea/
*.swp

# Editor / tool artifacts (regenerable, never reviewed)
.history/
.backups/
*.lck
~*.lck
.selftest-*.bak

# KiCad intermediates the pipeline regenerates every run
*.dsn
*.ses
erc-check.json

# Generated status mirrors are not design authority. Use the current CLI;
# netmap.json remains tracked as a reviewable connectivity contract.
HUMAN_WORK.md
projects/*/STATUS.md
projects/*/PIPELINE.json
projects/*/drc-report.json
projects/*/erc-report.json
projects/*/*.route-report.json
projects/*/*.drc.json
projects/*/*.postfix.drc.json

# Fabrication output is derived from the board and is regenerated by the
# pipeline fab stage. Tracked gerbers go stale silently, and a stale gerber
# folder is the only artifact here that can turn into wrong physical hardware.
projects/*/fabrication/

# Per-user KiCad UI state — pure churn, never part of the design.
projects/*/*.kicad_prl
