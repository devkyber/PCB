(version 1)

# Workspace baseline for 2-layer FR4, 1 oz, green solder mask only.
# Checked 2026-10-05 against https://jlcpcb.com/capabilities/pcb-capabilities
# Values include conservative workspace choices; they are not all factory minima.
# Board Setup contains the general copper, via, mask and text constraints.

(rule "JLCPCB PTH hole to other-net copper"
  (condition "A.Pad_Type == 'Through-hole' || B.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.28mm)))

(rule "JLCPCB component hole spacing"
  (condition "A.Type == 'Pad' || B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))

(rule "JLCPCB recommended component annular ring"
  (condition "A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.25mm)))

(rule "JLCPCB non-plated round hole"
  (condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X == A.Hole_Size_Y")
  (constraint hole_size (min 0.5mm)))

(rule "JLCPCB plated slot"
  (condition "A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y")
  (constraint hole_size (min 0.5mm)))

(rule "JLCPCB non-plated slot"
  (condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X != A.Hole_Size_Y")
  (constraint hole_size (min 1mm)))

# Text thickness constraints alone do not check footprint outline strokes.
# Zero-width borders (normally filled shapes) need separate feature-size review.
(rule "JLCPCB silkscreen graphic stroke"
  (condition "A.Type == 'Graphic' && (A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS')")
  (constraint assertion "A.Line_Width == 0mm || A.Line_Width >= 0.15mm"))
