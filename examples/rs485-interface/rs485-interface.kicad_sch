	(text "01  HOST UART / 3.3 V ONLY"
		(at 25.4 28.39 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "165dbdcc-de99-492b-84ef-a522ed899f17")
	)
	(text "J1: TXD into board; RXD out. DE and nRE independent.\nSupply + logic must be present together; no 5 V host signals."
		(at 25.4 36 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "8ca853a8-23c5-477e-b8e2-f988be69aec5")
	)
	(text "02  TRANSCEIVER + LOCAL BYPASS"
		(at 105.41 19.5 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "c16074f4-477c-45c4-b3ca-0fdc70a8d20a")
	)
	(text "C1 at U1 pin 8. C2 adds board-entry reservoir; not a TI minimum.\nTHVD1450DR: 1=RO  2=nRE  3=DE  4=DI  5=GND  6=A  7=B  8=VCC"
		(at 105.41 26.7 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "86127afb-da5f-4e0e-982a-9462f165edfe")
	)
	(text "03  RS-485 BUS / END TERMINATION"
		(at 187.96 40.64 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "ff8bba66-1be7-461b-881b-e25a92882e90")
	)
	(text "JP1: fit SNT-100-BK-G shunt only at cable end.\nRemove for middle nodes. R3 = 120 Ohm, 1%, 0.25 W.\nA/B naming follows TI: D=1 gives A > B."
		(at 194.31 50 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "2817b8e1-f3e6-41d3-9f96-0979cbe0d1de")
	)
	(text "DEFAULT: DE=0 disables drive; nRE=0 enables receive.\n10k max 10.1k x 6.2uA = 62.62mV < VIL 0.8V (TI).\nController leakage and startup state still need review."
		(at 76.2 127.45 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left)
		)
		(uuid "f193ab5f-76af-4e09-a2c9-fd375ed829ef")
	)
	(text "DESIGN BASIS / UNBUILT DRAFT"
		(at 152.4 123.64 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "ef9ac230-5624-45ee-b545-27ef0539db04")
	)
	(text "3.3V nominal / 3.0-3.6V input. Initial bench target 115200 baud.\nNo isolation, external TVS, surge, EMC or link-speed qualification.\nTI internal failsafe: no external A/B bias fitted.\nR3 bound: 3.6V^2 / 118.8 Ohm = 109.1mW; verify real bus faults."
		(at 152.4 132.53 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left)
		)
		(uuid "6812fa86-7130-4f75-b3e9-696906848c1e")
	)
