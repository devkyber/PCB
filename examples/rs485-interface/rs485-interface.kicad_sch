			)
			(justify left)
		)
		(uuid "f565a388-43a9-4b0f-a6ff-734b5ea663f2")
	)
	(text "4 x 3.2mm NPTH / 50 x 35mm PCB\nNo purchased fasteners selected."
		(at 20.32 175.71 0)
