	(text "CONTROLLER / TEENSY 4.1"
		(at 20.32 17.78 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7c75d2c7-4d46-4281-a2fd-1593d18106ac")
	)
	(text "ACQUISITION AND LOGGING"
		(at 165.1 27.94 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7e04c205-a482-44cb-ba26-faf16ddc147b")
	)
	(text "SPI0: thrust, sheet 4. SPI1: pressure, sheet 6.\nSerial3: radio, sheet 7. SD socket is on U1.\nSerial3: TX14 / RX15 / CTS19 / RTS18.\nAll I/O is 3.3 V; no I/O pin is 5 V tolerant."
		(at 165.1 34.29 0)
		(effects
			(font
				(size 1.397 1.397)
			)
			(justify left top)
		)
		(uuid "5bc83bb9-cd98-495c-adfe-c287a5c3a9cc")
	)
	(text "USB / BATTERY CONFIGURATION"
		(at 165.1 64.77 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4449b2c7-677f-4084-ac7a-55000dad6cff")
	)
	(text "Remove JP1 for simultaneous battery + USB,\nor cut VIN-VUSB link on the module per PJRC.\nUSB alone leaves ADC analog rails off."
		(at 165.1 71.12 0)
		(effects
			(font
				(size 1.397 1.397)
			)
			(justify left top)
		)
		(uuid "6e2921a9-a827-4940-bf2a-94407ee2d015")
	)
	(text "STATUS / DEFAULTS"
		(at 165.1 100.33 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "df45ed9d-9026-4a14-ab68-368bf6ee9673")
	)
	(text "+3V3 supplies ADC logic only (<10 mA plan).\nRed = command state; no physical ARM sense.\nFirmware must initialize FIRE low."
		(at 165.1 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0d749d4a-d9b3-4c15-89a0-21863211f5b7")
	)
	(text "Socket rows: 2 x 24 contacts.\n2.54 mm pitch; 15.24 mm rows.\nVerify fit and vendor pin IDs."
		(at 20.32 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c005a9a6-805d-4ad0-9fd0-2b4c7fd4c1bc")
	)
