	(text "IGNITION / COIL CONTROL + SERIES ARM"
		(at 20.32 17.78 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "016009b2-f9f3-42ec-846f-665863c26c82")
	)
	(text "COIL DRIVER"
		(at 20.32 133.35 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b9bd688d-fa80-410f-974e-62b524556fbe")
	)
	(text "125 Ohm +/-10% coil: ~40 mA nominal; 47 mA plan.\nR60/R61 give ~3.0 V gate drive; pull-down defaults OFF.\nD60 cathode to +5V; anode to coil drain.\nOnly the coil shares electronics GND."
		(at 20.32 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a7fa6ad9-5f34-4549-9f07-d3fcd727abdb")
	)
	(text "SEPARATE CONTACT DOMAIN"
		(at 182.88 146.05 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "72198fde-c24f-43bc-af29-9bcd57f65e85")
	)
	(text "2S -> physical ARM -> NO contact -> load.\nIGN_GND has no electronics GND bond.\nNo continuity sense or physical ARM feedback."
		(at 182.88 152.4 0)
		(effects
			(font
				(size 1.143 1.143)
			)
			(justify left top)
		)
		(uuid "0d9205fd-e9f6-47df-b7bb-c5bf6c3e5d2d")
	)
	(text "Design assumption: load <=2 A at8.4 V; cold resistance >=4.2 Ohm.\nRelay rated5 A resistive/30 VDC; assembled path still needs dummy-load qualification.\nUse dummy-load reset/fault tests; no live ignition approval or two-fault inhibit claim."
		(at 20.32 179.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a642bd46-2e7f-47f0-a2f9-33c65944c55a")
	)
