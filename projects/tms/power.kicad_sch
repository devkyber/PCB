	)
	(text "VOUT = 0.600 x (1 + 100.0499k / 13.7k) = 4.982 V.\nPlanning load: 1 A. IC limit is not a board current rating.\nC3 is the floating bootstrap capacitor. R3/R4 set VOUT;\nR5 permits loop-injection testing; C9 removed.\nLMR51430YF: 1.1 MHz FPWM; L1 = 3.3 uH.\nInput bank: C1/C11/C12 = 30 uF nominal, 50 V.\nOutput bank: C4/C5/C13-C19/C29 = 100 uF nominal, 50 V.\nUse effective capacitance and the candidate audit bounds."
		(at 21.428571 172.857143 0)
		(effects
			(font
				(size 1.397 1.397)
			)
			(justify left top)
		)
		(uuid "e9980e30-d933-4e74-ac58-c65ea5ed3d0e")
	)
	(text "Input: 12-16.8 V. External fuse and 4S low-voltage\nprotection required. R1/R2 EN network is not a LiPo cutoff.\nD2: 18 V stand-off; 29.2 V clamp at specified pulse.\nSee verification guide / TI LMR51430 Table 9-2."
		(at 21.428571 215.714286 0)
		(effects
			(font
				(size 1.397 1.397)
			)
			(justify left top)
		)
		(uuid "f5f9c3a3-bd01-405e-a6d4-5a92ebd83c76")
	)
	(text "ANALOG BRANCH"
		(at 275.714286 17.142857 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
