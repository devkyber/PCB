	(text "PRESSURE / BUFFERED 0-5 V TO ADS1220"
		(at 20.32 17.78 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "19fd38af-fe8a-4646-aaf8-e1afca7cccdf")
	)
	(text "SCALING / 50 Hz DESIGN BAND"
		(at 20.32 173.99 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "64fb6af0-0ad4-4d03-890f-f866ce28f916")
	)
	(text "100k / 33.2k, 0.1%: k = 0.249249; 5 V -> 1.24625 V.\nRTH = 24.925k; C40 = 47 nF C0G: fc ~=136 Hz.\nU10 prevents the high-impedance divider from directly driving U7.\nR46 / C44 isolate the op-amp from ADC charge pulses (47 Ohm / 10 nF)."
		(at 20.32 181.61 0)
		(effects
			(font
				(size 1.397 1.397)
			)
			(justify left top)
		)
		(uuid "188ff557-bf53-42b6-9d6d-f5f14a1cbd3d")
	)
	(text "ADC / FIRMWARE CONTRACT"
		(at 228.6 173.99 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "1875e205-00e6-434f-8562-205a1b60bb7b")
	)
	(text "AIN0-to-AVSS; gain1; PGA bypass; internal2.048 V.\nInternal clock, normal1000 SPS; ~61% positive range.\nUnused analog/reference pins6/7/8/9/10: NC.\nCLK3, DGND4, AVSS5: GND. IDAC / low-side switch OFF."
		(at 228.6 181.61 0)
		(effects
			(font
				(size 1.397 1.397)
			)
			(justify left top)
		)
		(uuid "1483fc91-23ee-47a1-92d2-632fdcf608a6")
	)
	(text "DESIGN ASSUMPTIONS / HARNESS"
		(at 20.32 226.06 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "e8594c32-339c-48f7-9a58-b1dd4fc5113e")
	)
	(text "Sensor output resistance <=100 Ohm is assumed, not specified by Sensata. Calibrate the complete chain.\nBoard J3: supply / signal / return; sensor DIN: supply / return / signal (pins1/3/2).\nInput is normally0-5 V. The sensor 32 V supply rating is not this board input rating.\nCable ESD, sustained miswiring and power-off injection need prototype qualification."
		(at 20.32 233.68 0)
		(effects
			(font
				(size 1.397 1.397)
			)
			(justify left top)
		)
		(uuid "91ecf169-1fb2-4022-9c13-dd4171dd0df8")
	)
