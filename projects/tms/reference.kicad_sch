	(text "REFERENCE / RATIOMETRIC VEXC / 2"
		(at 20.32 17.78 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "bd765ed5-e856-4267-8569-7b163d849ad8")
	)
	(text "WHY THIS CIRCUIT"
		(at 20.32 133.35 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ca6252ed-bc24-4577-8232-dff6665d32a4")
	)
	(text "R30/R31 sense the actual bridge excitation. U6 drives ADC reference current.\nVREF = VEXC x R31 / (R30 + R31) ~= VEXC/2, nominal 2.49 V.\nR32/C30: (5k + 10k) x 1 uF = 15 ms; allow >=150 ms before calibration.\nC32/C34: Panasonic FT; ESR max0.85/0.36 Ohm at100kHz. Validate loop stability."
		(at 20.32 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a9f1314d-ce52-4f1a-9c6f-5d56aa9e2061")
	)
	(text "Place C31 at U6 and the output bank at U5 VREFP/VREFN.\nUnused package pads 1/5/8 are shown NC. See guide for ratio/offset and noise checks."
		(at 20.32 179.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c45bdfae-4543-49b7-8f80-17c52785735a")
	)
