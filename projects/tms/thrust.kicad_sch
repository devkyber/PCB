				(bold yes)
			)
			(justify left top)
		)
		(uuid "623c1da2-960d-43e3-ae6d-baefdcb3b5c7")
	)
	(text "AIN0-AIN1; PGA64; buffer ON.\n1000 SPS; mode 1; SCLK <=1.92 MHz.\nVREF ~2.49 V; differential FS ~+/-77.8 mV.\nCL estimate: 30p/2 + 3p stray = 18 pF."
		(at 275.714286 241.428571 0)
		(effects
			(font
				(size 1.143 1.143)
			)
			(justify left top)
		)
