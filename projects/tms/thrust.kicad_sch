	(text "BCA-100L: nominal 10 mV at 100 kgf with 5 V excitation.\nR20/R21 + C20: differential pole ~308 Hz including sensor.\nU4 unity buffers avoid loading the bridge with the ADC.\nCalibrate buffer offset, ADC loading and the complete chain."
		(at 21.428571 240 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "357969b5-c898-4b51-ab34-d0ec42ef2fdd")
	)
	(text "ADC CONFIGURATION"
		(at 275.714286 234.285714 0)
		(effects
			(font
